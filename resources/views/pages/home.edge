<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Accueil</title>
    <link rel="icon" href="https://www.etml.ch/themes/etml/assets/images/etml_favicon_v3.ico">
    <link rel="stylesheet" href="/resources/css/app.css">
</head>
<body>
    <header>
        <img src="https://www.etml.ch/themes/etml/assets/images/etml_logo_complet.svg" draggable="false">
        <h1>Questionnaire</h1>
    </header>
    <main>
        <h1>Entrez votre nom</h1>
		<form method="post" action="/">
          {{ csrfField() }}
          <input type="text" placeholder="Écrivez-ici..." name="prenom">
        
        </form>

    </main>
    <script>
  document.addEventListener('DOMContentLoaded', function() {
    document.addEventListener('contextmenu', function(e) {
      e.preventDefault();
    });
  });
</script>
</body>
</html>